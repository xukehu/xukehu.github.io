---
import profile from '../data/profile.json';
import { withBase } from '../utils/paths';

const navItems = [
  { label: 'Home', href: '#top' },
  { label: 'About', href: '#about' },
  { label: 'Service', href: '#service' },
  { label: 'Publications', href: '#publications' },
  { label: 'Projects', href: '#projects' },
  { label: 'Contact', href: '#contact' }
];

const base = import.meta.env.BASE_URL || '/';
const pathname = Astro.url.pathname;
const normalizedPath = pathname.startsWith(base) ? `/${pathname.slice(base.length)}`.replace('//', '/') : pathname;
const isActive = (href) => normalizedPath === '/' && href === '#top';
const baseUrl = withBase('/');
---
<header class="sticky top-0 z-40 border-b border-ink-100/60 bg-white/80 backdrop-blur-md dark:border-ink-800/60 dark:bg-ink-900/70">
  <div class="mx-auto flex max-w-content flex-wrap items-center justify-between gap-4 px-6 py-4">
    <a href={withBase('/')} class="flex items-center gap-3">
      <div class="site-avatar rounded-full bg-brand-600 text-white grid place-items-center font-semibold">XH</div>
      <div class="text-lg font-semibold text-ink-800 dark:text-ink-100">{profile.name}</div>
    </a>
    <nav class="flex flex-wrap items-center gap-2">
      {navItems.map((item) => (
        <a
          class={`nav-pill ${isActive(item.href) ? 'active' : 'inactive'}`}
          href={`${baseUrl}${item.href}`}
        >
          {item.label}
        </a>
      ))}
      <button
        id="theme-toggle"
        class="nav-pill inactive border border-ink-100/70 dark:border-ink-700/60"
        type="button"
        aria-pressed="false"
        aria-label="Toggle dark mode"
      >
        Theme
      </button>
    </nav>
  </div>
</header>
