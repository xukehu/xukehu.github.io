---
import ProfilePhoto from './ProfilePhoto.astro';
import Badge from './Badge.astro';
import profile from '../data/profile.json';
import { withBase } from '../utils/paths';
const { researchKeywords } = profile;
---
<section class="hero-gradient">
  <div class="mx-auto max-w-content px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[auto,1fr] lg:items-center">
      <ProfilePhoto size="lg" priority={true} />
      <div>
        <div class="text-base uppercase tracking-[0.2em] text-brand-600">Academic Profile</div>
        <h1 class="mt-4 text-6xl font-semibold text-ink-900 dark:text-white md:text-7xl">{profile.name}</h1>
        <p class="mt-4 text-2xl text-muted">{profile.title}</p>
        <p class="text-xl text-muted">{profile.affiliation} · {profile.location}</p>
        <div class="mt-4 flex flex-wrap items-center gap-4 text-xl text-muted">
          <a class="underline underline-offset-4" href={`mailto:${profile.email}`}>{profile.email}</a>
          <div class="flex flex-wrap items-center gap-3">
            <a class="rounded-full border border-ink-200/70 p-2 text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200" href="https://github.com/uhuohuy" target="_blank" rel="noreferrer" aria-label="GitHub">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 .5C5.73.5.5 5.74.5 12.2c0 5.22 3.44 9.64 8.2 11.2.6.12.82-.27.82-.6 0-.3-.01-1.1-.02-2.17-3.34.75-4.04-1.66-4.04-1.66-.55-1.44-1.34-1.82-1.34-1.82-1.1-.77.08-.75.08-.75 1.22.09 1.86 1.29 1.86 1.29 1.08 1.9 2.83 1.35 3.52 1.03.11-.8.42-1.35.76-1.66-2.66-.31-5.46-1.38-5.46-6.12 0-1.35.46-2.45 1.22-3.31-.12-.31-.53-1.57.12-3.27 0 0 1-.33 3.3 1.26.96-.27 1.99-.4 3.02-.4 1.03 0 2.06.14 3.02.4 2.3-1.59 3.3-1.26 3.3-1.26.65 1.7.24 2.96.12 3.27.76.86 1.22 1.96 1.22 3.31 0 4.75-2.8 5.8-5.47 6.11.43.38.81 1.12.81 2.26 0 1.63-.02 2.94-.02 3.34 0 .33.22.72.83.6 4.75-1.56 8.18-5.98 8.18-11.2C23.5 5.74 18.27.5 12 .5z"/></svg>
            </a>
            <a class="rounded-full border border-ink-200/70 p-2 text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200" href={profile.links.website} target="_blank" rel="noreferrer" aria-label="Website">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2a10 10 0 100 20 10 10 0 000-20Zm6.9 6h-2.74a15.7 15.7 0 00-1.18-3.05A8.03 8.03 0 0118.9 8ZM12 4.1c.67.95 1.23 2.07 1.66 3.9H10.34c.43-1.83.99-2.95 1.66-3.9ZM5.1 8a8.03 8.03 0 013.92-3.05A15.7 15.7 0 007.84 8H5.1Zm0 8h2.74c.27 1.12.64 2.18 1.18 3.05A8.03 8.03 0 015.1 16Zm4.24 0h3.32c-.43 1.83-.99 2.95-1.66 3.9-.67-.95-1.23-2.07-1.66-3.9Zm5.82 3.05c.54-.87.9-1.93 1.18-3.05h2.74a8.03 8.03 0 01-3.92 3.05ZM19.6 14h-3.08c.08-.65.13-1.33.13-2s-.05-1.35-.13-2h3.08a8.16 8.16 0 010 4Zm-5.42 0h-4.36a13.7 13.7 0 010-4h4.36a13.7 13.7 0 010 4Zm-6.7 0H4.4a8.16 8.16 0 010-4h3.08c-.08.65-.13 1.33-.13 2s.05 1.35.13 2Z"/></svg>
            </a>
            <a class="rounded-full border border-ink-200/70 p-2 text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200" href={profile.links.scholar} target="_blank" rel="noreferrer" aria-label="Google Scholar">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 3L1 9l11 6 9-4.91V17h2V9L12 3Zm-6.2 6L12 5.65 18.2 9 12 12.35 5.8 9Zm1.7 5.55V18c0 1.66 2.02 3 4.5 3s4.5-1.34 4.5-3v-3.45l-4.5 2.45-4.5-2.45Z"/></svg>
            </a>
            <a class="rounded-full border border-ink-200/70 p-2 text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200" href={profile.links.researchgate} target="_blank" rel="noreferrer" aria-label="ResearchGate">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M3 4h10a4 4 0 010 8H7v8H3V4Zm4 4h6a1.5 1.5 0 000-3H7v3Zm9 4h2a3 3 0 013 3v5h-4v-5a1 1 0 00-1-1h-2v-2Z"/></svg>
            </a>
            <a class="rounded-full border border-ink-200/70 p-2 text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200" href={profile.links.orcid} target="_blank" rel="noreferrer" aria-label="ORCID">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M7.2 5.5A1.7 1.7 0 105.5 7.2a1.7 1.7 0 001.7-1.7ZM4.7 9H7v10H4.7V9Zm4.8 0h4.3c3 0 5 2.1 5 5s-2 5-5 5H9.5V9Zm2.3 2.2v5.6h1.8c1.7 0 2.8-1.1 2.8-2.8s-1.1-2.8-2.8-2.8h-1.8Z"/></svg>
            </a>
            <a class="rounded-full border border-ink-200/70 p-2 text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200" href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
              <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 102.5 6a2.5 2.5 0 002.48-2.5ZM3 8.98h4v12H3v-12Zm7 0h3.8v1.64h.05a4.16 4.16 0 013.75-2.06c4.01 0 4.75 2.64 4.75 6.07v6.35h-4v-5.63c0-1.34-.02-3.06-1.86-3.06-1.86 0-2.14 1.45-2.14 2.96v5.73h-4v-12Z"/></svg>
            </a>
          </div>
        </div>
        <div class="mt-8">
          <div class="text-lg font-semibold text-ink-700 dark:text-ink-200">Research focus</div>
          <div class="mt-3 flex flex-wrap gap-2">
            {researchKeywords.map((keyword) => (
              <Badge label={keyword} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
