---
import ProfilePhoto from './ProfilePhoto.astro';
import Badge from './Badge.astro';
import profile from '../data/profile.json';
import { withBase } from '../utils/paths';
const { researchKeywords } = profile;
---
<section class="hero-gradient">
  <div class="mx-auto max-w-content px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[auto,1fr] lg:items-center">
      <ProfilePhoto size="lg" priority={true} />
      <div>
        <div class="text-base uppercase tracking-[0.2em] text-brand-600">Academic Profile</div>
        <h1 class="mt-4 text-6xl font-semibold text-ink-900 dark:text-white md:text-7xl">{profile.name}</h1>
        <p class="mt-4 text-2xl text-muted">{profile.title}</p>
        <p class="text-xl text-muted">{profile.affiliation} · {profile.location}</p>
        <p class="text-xl text-muted">{profile.email}</p>
        <div class="mt-6 flex flex-wrap items-center gap-3 text-sm">
          <a class="badge" href={`mailto:${profile.email}`}>Email</a>
          <a class="badge" href={`${withBase('/')}#publications`}>Publications</a>
          <a class="badge" href={`${withBase('/')}#contact`}>Contact</a>
        </div>
        <div class="mt-8">
          <div class="text-lg font-semibold text-ink-700 dark:text-ink-200">Research focus</div>
          <div class="mt-3 flex flex-wrap gap-2">
            {researchKeywords.map((keyword) => (
              <Badge label={keyword} />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
