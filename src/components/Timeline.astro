---
const { items = [] } = Astro.props;
---
<div class="relative timeline-line pl-10">
  <div class="space-y-8">
    {items.map((item) => (
      <div class="relative">
        <div class="absolute -left-[0.35rem] top-1.5 h-3 w-3 rounded-full bg-brand-500"></div>
        <div class="section-card p-5">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <div>
              <h3 class="text-xl font-semibold text-ink-900 dark:text-white">{item.title}</h3>
              <p class="text-base text-muted">{item.org}</p>
            </div>
            <div class="text-base text-muted">{item.period}</div>
          </div>
          {item.location && <p class="mt-1 text-base text-muted">{item.location}</p>}
          {item.details?.length ? (
            <ul class="mt-4 list-disc space-y-2 pl-5 text-base text-ink-700 dark:text-ink-200">
              {item.details.map((detail) => (
                <li>{detail}</li>
              ))}
            </ul>
          ) : null}
        </div>
      </div>
    ))}
  </div>
</div>
