---
import Badge from './Badge.astro';

const { publication } = Astro.props;
const doiUrl = publication.doi ? (publication.doi.startsWith('http') ? publication.doi : `https://doi.org/${publication.doi}`) : '';
const searchText = `${publication.title} ${publication.authors} ${publication.venue}`.toLowerCase();
---
<article
  class="card flex flex-col gap-4"
  data-year={publication.year}
  data-type={publication.type}
  data-search={searchText}
  data-bibtex={publication.bibtex}
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <div class="text-sm text-muted">{publication.year}</div>
      <h3 class="text-lg font-semibold text-ink-900 dark:text-white">{publication.title}</h3>
      <p class="text-sm text-muted">{publication.authors}</p>
      <p class="mt-1 text-sm text-ink-700 dark:text-ink-200">{publication.venue}</p>
    </div>
    <Badge label={publication.type} />
  </div>
  <div class="flex flex-wrap items-center gap-3 text-sm">
    {doiUrl && (
      <a class="badge" href={doiUrl} target="_blank" rel="noreferrer">DOI</a>
    )}
    {publication.tags?.map((tag) => (
      <span class="badge">{tag}</span>
    ))}
  </div>
  <div class="flex flex-wrap gap-3">
    <button
      type="button"
      class="rounded-full border border-ink-200/70 px-4 py-2 text-sm font-medium text-ink-700 transition hover:border-brand-400 hover:text-brand-700 dark:border-ink-700 dark:text-ink-200"
      data-copy-bibtex
    >
      Copy BibTeX
    </button>
  </div>
</article>
