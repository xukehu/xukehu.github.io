---
import { Image } from 'astro:assets';
import { withBase } from '../utils/paths';

const { size = 'md', className = '', priority = false } = Astro.props;

const imageMap = import.meta.glob('../assets/*.{jpg,jpeg,png}', { eager: true });
const primaryKey = Object.keys(imageMap).find((key) => key.endsWith('/Xuke_hu.jpeg'));
const fallbackKey = Object.keys(imageMap).find((key) => key.endsWith('/profile.jpg'));
const localImage = primaryKey
  ? imageMap[primaryKey].default
  : fallbackKey
    ? imageMap[fallbackKey].default
    : null;

const sizeMap = {
  sm: 96,
  md: 128,
  lg: 168
};

const dimension = sizeMap[size] || sizeMap.md;
const classes = `rounded-2xl border border-white/60 shadow-soft ring-1 ring-ink-200/40 dark:ring-ink-700/60 ${className}`;
const alt = 'Portrait of Dr. rer. nat. Xuke Hu';
const fallbackSrc = withBase('/Xuke_hu.jpeg');
---
{localImage ? (
  <Image
    src={localImage}
    alt={alt}
    width={dimension}
    height={dimension}
    class={classes}
    sizes="(max-width: 640px) 96px, 168px"
    priority={priority}
  />
) : (
  <img
    src={fallbackSrc}
    alt={alt}
    width={dimension}
    height={dimension}
    class={classes}
    loading={priority ? 'eager' : 'lazy'}
    onerror={`this.onerror=null;this.src='${withBase('/profile.jpg')}'`}
  />
)}
