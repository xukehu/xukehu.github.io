---
import { Image } from 'astro:assets';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import { withBase } from '../utils/paths';

const { size = 'md', className = '', priority = false } = Astro.props;

const primaryAssetUrl = new URL('../assets/Xuke_hu.jpeg', import.meta.url);
const fallbackAssetUrl = new URL('../assets/profile.jpg', import.meta.url);
const hasPrimary = existsSync(fileURLToPath(primaryAssetUrl));
const hasFallback = existsSync(fileURLToPath(fallbackAssetUrl));
let localImage = null;
if (hasPrimary) {
  localImage = (await import('../assets/Xuke_hu.jpeg')).default;
} else if (hasFallback) {
  localImage = (await import('../assets/profile.jpg')).default;
}

const sizeMap = {
  sm: 96,
  md: 128,
  lg: 168
};

const dimension = sizeMap[size] || sizeMap.md;
const classes = `rounded-2xl border border-white/60 shadow-soft ring-1 ring-ink-200/40 dark:ring-ink-700/60 ${className}`;
const alt = 'Portrait of Dr. rer. nat. Xuke Hu';
const fallbackSrc = withBase('/Xuke_hu.jpeg');
---
{localImage ? (
  <Image
    src={localImage}
    alt={alt}
    width={dimension}
    height={dimension}
    class={classes}
    sizes="(max-width: 640px) 96px, 168px"
    priority={priority}
  />
) : (
  <img
    src={fallbackSrc}
    alt={alt}
    width={dimension}
    height={dimension}
    class={classes}
    loading={priority ? 'eager' : 'lazy'}
    onerror={`this.onerror=null;this.src='${withBase('/profile.jpg')}'`}
  />
)}
