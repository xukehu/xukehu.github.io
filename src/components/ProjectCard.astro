---
import Badge from './Badge.astro';
const { project } = Astro.props;
---
<div class="card flex flex-col gap-3">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="text-2xl font-semibold text-ink-900 dark:text-white">{project.name}</h3>
      <p class="text-lg text-muted">{project.year}</p>
    </div>
    <Badge label={project.type} />
  </div>
  <p class="text-lg text-muted">{project.description}</p>
  <div class="flex flex-wrap gap-2">
    {project.tags?.map((tag) => (
      <span class="badge">{tag}</span>
    ))}
  </div>
  <div class="text-lg">
    {project.link ? (
      <a href={project.link} target="_blank" rel="noreferrer">{project.linkLabel || 'Project link'}</a>
    ) : (
      <span class="text-muted">{project.placeholder || 'Link: TODO (add URL)'}</span>
    )}
  </div>
</div>
