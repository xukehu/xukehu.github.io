---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import profile from '../data/profile.json';
import { withBase } from '../utils/paths';

const description = 'Curriculum vitae summary and downloadable PDF for Dr. rer. nat. Xuke Hu.';
const cvUrl = withBase('/cv.pdf');
---
<BaseLayout title="CV" description={description}>
  <section class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="Curriculum vitae" subtitle="Summary of positions, education, skills, and patents." />
    <div class="flex flex-wrap gap-4">
      <a class="badge" href={cvUrl} download>Download CV (PDF)</a>
      <a class="badge" href={cvUrl} target="_blank" rel="noreferrer">Open PDF</a>
    </div>
    <div class="mt-10 grid gap-10">
      <div>
        <h3 class="text-2xl font-semibold text-ink-900 dark:text-white">Positions</h3>
        <div class="mt-6">
          <Timeline items={profile.positions} />
        </div>
      </div>
      <div>
        <h3 class="text-2xl font-semibold text-ink-900 dark:text-white">Education</h3>
        <div class="mt-6">
          <Timeline items={profile.education} />
        </div>
      </div>
      <div class="section-card p-6">
        <h3 class="text-xl font-semibold text-ink-900 dark:text-white">Skills & languages</h3>
        <p class="mt-2 text-sm text-muted">Languages: {profile.languages.join(', ')}</p>
        <p class="text-sm text-muted">Programming: {profile.skills.join(', ')}</p>
      </div>
      <div class="section-card p-6">
        <h3 class="text-xl font-semibold text-ink-900 dark:text-white">Patents</h3>
        <ul class="mt-4 space-y-3 text-sm text-muted">
          {profile.patents.map((patent) => (
            <li class="rounded-xl border border-ink-100/70 p-4 dark:border-ink-700/60">
              <div class="font-medium text-ink-800 dark:text-ink-100">{patent.title}</div>
              <div class="text-xs text-muted">{patent.year} · {patent.number} · {patent.status}</div>
              <div class="mt-2 text-xs text-muted">Inventors: {patent.inventors}</div>
            </li>
          ))}
        </ul>
      </div>
      <div class="section-card p-6">
        <h3 class="text-xl font-semibold text-ink-900 dark:text-white">CV preview (optional)</h3>
        <div class="mt-4 aspect-[4/3] w-full overflow-hidden rounded-2xl border border-ink-100/70 dark:border-ink-700/60">
          <iframe title="CV preview" src={cvUrl} class="h-full w-full" loading="lazy"></iframe>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
