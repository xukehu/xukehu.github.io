---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FilterBar from '../components/FilterBar.astro';
import PublicationCard from '../components/PublicationCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import profile from '../data/profile.json';
import publicationsData from '../data/publications.json';
import projects from '../data/projects.json';
import service from '../data/service.json';

const description = 'Academic homepage of Dr. rer. nat. Xuke Hu, Senior Researcher at DLR Institute of Data Science, specializing in GeoAI and geospatial information extraction.';
const publications = [...publicationsData].sort((a, b) => b.year - a.year);
const years = [...new Set(publications.map((pub) => pub.year))].sort((a, b) => b - a);
const types = [...new Set(publications.map((pub) => pub.type))].sort();
---
<BaseLayout title="Home" description={description} isHome={true}>
  <div id="top">
    <Hero />
  </div>

  <section id="location" class="mx-auto max-w-content px-6 py-16">
    <div class="section-card p-6">
      <div class="grid gap-6 lg:grid-cols-[1fr,1.2fr] lg:items-center">
        <div>
          <h2 class="text-4xl font-semibold text-ink-900 dark:text-white">Institute location</h2>
          <p class="mt-3 text-xl text-muted">{profile.affiliation}</p>
          <p class="text-xl text-muted">{profile.address}</p>
          <a class="badge mt-4" href="https://maps.google.com/maps?q=M%C3%A4lzerstr.%203-5%2C%2007745%20Jena%2C%20Germany&output=embed" target="_blank" rel="noreferrer">Open in Google Maps</a>
        </div>
        <div class="overflow-hidden rounded-2xl border border-ink-100/70 dark:border-ink-700/60">
          <iframe
            title="DLR Institute of Data Science location"
            src="https://maps.google.com/maps?q=M%C3%A4lzerstr.%203-5%2C%2007745%20Jena%2C%20Germany&output=embed"
            class="h-[320px] w-full md:h-[360px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <section id="about" class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="About" />
    <div class="section-card p-6">
      <p class="text-xl text-muted">
        I received my Ph.D. in Geoinformatics from Heidelberg University under the supervision of
        <a class="underline underline-offset-4" href="https://www.geog.uni-heidelberg.de/de/personen-am-institut/prof-dr-alexander-zipf" target="_blank" rel="noreferrer">Prof. Alexander Zipf</a>
        and
        <a class="underline underline-offset-4" href="https://www.ntnu.edu/employees/hongchao.fan" target="_blank" rel="noreferrer">Prof. Hongchao Fan</a>.
        Since 2019, I have been with the
        <a class="underline underline-offset-4" href="https://www.dlr.de/en/dw" target="_blank" rel="noreferrer">DLR Institute of Data Science</a>,
        where I joined as a postdoctoral researcher and transitioned to a permanent researcher position in 2023.
      </p>
      <p class="mt-4 text-xl text-muted">{profile.researchSummary}</p>
    </div>
  </section>

  <section id="service" class="mx-auto max-w-content px-6 pb-16">
    <SectionHeader title="Academic service" />
    <div class="grid gap-6">
      {service.map((group) => (
        <div class="section-card p-6">
          <h3 class="text-2xl font-semibold text-ink-900 dark:text-white">{group.group}</h3>
          <ul class="mt-4 space-y-3 text-xl text-muted">
            {group.items.map((item) => (
              <li class="flex flex-wrap items-center justify-between gap-2 border-b border-ink-100/70 pb-3 last:border-b-0 dark:border-ink-700/60">
                {item.url ? (
                  <a class="text-ink-800 hover:text-brand-700 dark:text-ink-100" href={item.url} target="_blank" rel="noreferrer">
                    {item.role}
                  </a>
                ) : (
                  <span class="text-ink-800 dark:text-ink-100">{item.role}</span>
                )}
                <span class="text-muted">{item.period}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="publications" class="mx-auto max-w-content px-6 pb-16">
    <SectionHeader title="Publications" subtitle="Selected journal articles and conference papers. Use search and filters to explore." />
    <FilterBar years={years} types={types} />
    <div class="mt-8 grid gap-6" id="publication-list">
      {publications.map((publication) => (
        <PublicationCard publication={publication} />
      ))}
    </div>
  </section>

  <section id="projects" class="mx-auto max-w-content px-6 pb-16">
    <SectionHeader title="Projects & datasets" subtitle="Software and data resources developed for toponym extraction, resolution, and geocoding." />
    <div class="card-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>

  <section id="contact" class="mx-auto max-w-content px-6 pb-20">
    <SectionHeader title="Contact" subtitle="Get in touch for research collaborations and academic inquiries." />
    <div class="section-card p-6 max-w-xl">
      <h3 class="text-3xl font-semibold text-ink-900 dark:text-white">{profile.name}</h3>
      <p class="mt-2 text-xl text-muted">{profile.affiliation}</p>
      <p class="text-xl text-muted">{profile.address}</p>
      <p class="mt-4 text-xl text-muted">Email: {profile.email}</p>
      <div class="mt-4 flex gap-3">
        <a class="badge" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const yearSelect = document.getElementById('filter-year');
      const typeSelect = document.getElementById('filter-type');
      const searchInput = document.getElementById('filter-search');
      const countEl = document.getElementById('filter-count');
      const cards = Array.from(document.querySelectorAll('[data-bibtex]'));

      const applyFilters = () => {
        const year = yearSelect?.value || 'all';
        const type = typeSelect?.value || 'all';
        const query = (searchInput?.value || '').trim().toLowerCase();
        let visible = 0;

        cards.forEach((card) => {
          const matchesYear = year === 'all' || card.dataset.year === year;
          const matchesType = type === 'all' || card.dataset.type === type;
          const matchesQuery = !query || (card.dataset.search || '').includes(query);
          const shouldShow = matchesYear && matchesType && matchesQuery;
          card.classList.toggle('hidden', !shouldShow);
          if (shouldShow) visible += 1;
        });

        if (countEl) {
          countEl.textContent = `${visible} publication${visible === 1 ? '' : 's'} shown.`;
        }
      };

      [yearSelect, typeSelect].forEach((select) => {
        if (select) select.addEventListener('change', applyFilters);
      });
      if (searchInput) searchInput.addEventListener('input', applyFilters);

      document.addEventListener('click', async (event) => {
        const button = event.target.closest('[data-copy-bibtex]');
        if (!button) return;
        const card = button.closest('[data-bibtex]');
        const bibtex = card?.dataset.bibtex;
        if (!bibtex) return;
        try {
          await navigator.clipboard.writeText(bibtex);
          const original = button.textContent;
          button.textContent = 'Copied!';
          setTimeout(() => {
            button.textContent = original;
          }, 1200);
        } catch (err) {
          button.textContent = 'Copy failed';
          setTimeout(() => {
            button.textContent = 'Copy BibTeX';
          }, 1200);
        }
      });

      applyFilters();
    })();
  </script>
</BaseLayout>
