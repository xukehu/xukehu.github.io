---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Timeline from '../components/Timeline.astro';
import profile from '../data/profile.json';
import highlights from '../data/highlights.json';
import { withBase } from '../utils/paths';

const description = 'Academic homepage of Dr. rer. nat. Xuke Hu, Senior Researcher at DLR Institute of Data Science, specializing in GeoAI and geospatial information extraction.';
---
<BaseLayout title="Home" description={description} isHome={true}>
  <Hero />
  <section class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="Research overview" subtitle="GeoAI-driven methods for extracting and analyzing geospatial information from multilingual text." />
    <div class="grid gap-8 lg:grid-cols-[1.2fr,1fr]">
      <div class="section-card p-6">
        <p class="text-muted">{profile.researchSummary}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {profile.linksList.map((link) => (
            link.url ? (
              <a class="badge" href={link.url} target="_blank" rel="noreferrer">{link.label}</a>
            ) : (
              <span class="badge">{link.label}: {link.note}</span>
            )
          ))}
        </div>
      </div>
      <div class="section-card p-6">
        <h3 class="text-lg font-semibold text-ink-900 dark:text-white">Current position</h3>
        <p class="mt-2 text-muted">{profile.positions[0].title}</p>
        <p class="text-sm text-muted">{profile.affiliation}</p>
        <p class="text-sm text-muted">{profile.address}</p>
        <div class="mt-4 flex gap-3">
          <a class="badge" href={withBase('/contact/')}>Contact</a>
          <a class="badge" href={withBase('/about/')}>More about me</a>
        </div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-content px-6 pb-16">
    <SectionHeader title="Highlights" subtitle="Selected milestones from publications, service, and datasets." />
    <div class="card-grid">
      {highlights.map((item) => (
        <div class="card">
          <div class="text-xs uppercase tracking-[0.2em] text-brand-600">{item.meta}</div>
          <h3 class="mt-3 text-lg font-semibold text-ink-900 dark:text-white">{item.title}</h3>
          <p class="mt-2 text-sm text-muted">{item.description}</p>
        </div>
      ))}
    </div>
  </section>
  <section class="mx-auto max-w-content px-6 pb-20">
    <SectionHeader title="Positions" subtitle="Research appointments at DLR." />
    <Timeline items={profile.positions} />
  </section>
</BaseLayout>
