---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import teaching from '../data/teaching.json';

const description = 'Teaching and mentoring activities by Dr. rer. nat. Xuke Hu.';
---
<BaseLayout title="Teaching" description={description}>
  <section class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="Teaching & mentoring" subtitle="Courses and supervision activities." />
    <div class="space-y-10">
      {teaching.map((group) => (
        <div class="section-card p-6">
          <h3 class="text-xl font-semibold text-ink-900 dark:text-white">{group.group}</h3>
          <div class="mt-4 space-y-4">
            {group.items.map((item) => (
              <div class="rounded-xl border border-ink-100/70 bg-white/60 p-4 dark:border-ink-700/60 dark:bg-ink-900/40">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="font-medium text-ink-800 dark:text-ink-100">{item.title}</div>
                  <div class="text-sm text-muted">{item.period}</div>
                </div>
                <div class="text-sm text-muted">{item.institution}</div>
                <p class="mt-2 text-sm text-muted">{item.details}</p>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
