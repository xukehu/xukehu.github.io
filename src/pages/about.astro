---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import Timeline from '../components/Timeline.astro';
import profile from '../data/profile.json';

const description = 'About Dr. rer. nat. Xuke Hu: GeoAI researcher focused on geospatial information extraction, multilingual text analysis, and indoor localization.';
---
<BaseLayout title="About" description={description}>
  <section class="mx-auto max-w-content px-6 py-16">
    <div class="grid gap-10 lg:grid-cols-[auto,1fr]">
      <ProfilePhoto size="md" />
      <div>
        <h1 class="text-4xl font-semibold text-ink-900 dark:text-white">About</h1>
        <p class="mt-4 text-muted">{profile.researchSummary}</p>
        <div class="mt-6 grid gap-6 md:grid-cols-2">
          <div class="section-card p-5">
            <h2 class="text-lg font-semibold text-ink-900 dark:text-white">Research interests</h2>
            <ul class="mt-3 list-disc space-y-2 pl-5 text-sm text-ink-700 dark:text-ink-200">
              {profile.researchKeywords.map((keyword) => (
                <li>{keyword}</li>
              ))}
            </ul>
          </div>
          <div class="section-card p-5">
            <h2 class="text-lg font-semibold text-ink-900 dark:text-white">Personal details</h2>
            <p class="mt-3 text-sm text-muted">Nationality: {profile.nationality}</p>
            <p class="text-sm text-muted">Birthplace: {profile.birthplace}</p>
            <p class="text-sm text-muted">Languages: {profile.languages.join(', ')}</p>
            <p class="text-sm text-muted">Programming: {profile.skills.join(', ')}</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="mx-auto max-w-content px-6 pb-20">
    <SectionHeader title="Education" subtitle="Academic training in geoinformatics and software engineering." />
    <Timeline items={profile.education} />
  </section>
</BaseLayout>
