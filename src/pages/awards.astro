---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import awards from '../data/awards.json';

const description = 'Honors and awards received by Dr. rer. nat. Xuke Hu.';
const sorted = [...awards].sort((a, b) => Number(b.year) - Number(a.year));
---
<BaseLayout title="Awards" description={description}>
  <section class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="Honors & awards" subtitle="Selected awards and recognitions." />
    <div class="section-card p-6">
      <ul class="space-y-4">
        {sorted.map((award) => (
          <li class="flex flex-wrap items-center justify-between gap-2 border-b border-ink-100/70 pb-3 last:border-b-0 dark:border-ink-700/60">
            <div>
              <div class="font-medium text-ink-900 dark:text-white">{award.title}</div>
              <div class="text-sm text-muted">{award.organization}</div>
            </div>
            <div class="text-sm text-muted">{award.year}</div>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
