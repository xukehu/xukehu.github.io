---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import ProjectCard from '../components/ProjectCard.astro';
import projects from '../data/projects.json';

const description = 'Open-source software and datasets developed by Dr. rer. nat. Xuke Hu.';
---
<BaseLayout title="Projects" description={description}>
  <section class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="Projects & datasets" subtitle="Software and data resources developed for toponym extraction, resolution, and geocoding." />
    <div class="card-grid">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>
  </section>
</BaseLayout>
