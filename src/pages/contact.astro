---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeader from '../components/SectionHeader.astro';
import profile from '../data/profile.json';

const description = 'Contact details for Dr. rer. nat. Xuke Hu at DLR Institute of Data Science.';
---
<BaseLayout title="Contact" description={description}>
  <section class="mx-auto max-w-content px-6 py-16">
    <SectionHeader title="Contact" subtitle="Get in touch for research collaborations and academic inquiries." />
    <div class="section-card p-6 max-w-xl">
      <h3 class="text-xl font-semibold text-ink-900 dark:text-white">{profile.name}</h3>
      <p class="mt-2 text-sm text-muted">{profile.affiliation}</p>
      <p class="text-sm text-muted">{profile.address}</p>
      <p class="mt-4 text-sm text-muted">Email: {profile.email}</p>
      <div class="mt-4 flex gap-3">
        <a class="badge" href={`mailto:${profile.email}`}>Email me</a>
      </div>
    </div>
  </section>
</BaseLayout>
